<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform>x64</Platform><PlatformTarget>x64</PlatformTarget><OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><AssemblyName>RugWindows</AssemblyName><RootNamespace>RugWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><OutputPath>build\vs\</OutputPath><Optimize>true</Optimize><LangVersion>5</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Runtime.Serialization"/><Reference Include="System.Xml"/><Reference Include="System.Xaml"/>
    <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
    <Compile Include="src\*.cs"/>
    <None Include="app.manifest"/>
    <Content Include="RugWindows.exe.config"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="LICENSE"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="original\under-the-rug-main\Resources\rugs\*.jpg"><Link>Resources\rugs\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="original\under-the-rug-main\Resources\floors\*.jpg"><Link>Resources\floors\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="original\under-the-rug-main\Resources\icon_1024.png"><Link>Resources\icon_1024.png</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Resources\**\*.*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
